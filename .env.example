# ==========================================
# Application Configuration
# ==========================================

APP_NAME=Autonomous Coding Agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# LLM Configuration
# ==========================================

# Supported: gemini, anthropic
LLM_PROVIDER=gemini

# Replace placeholders with actual API credentials.
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Specify a model explicitly.
# LLM_MODEL=your-model-name

# ==========================================
# Database Configuration
# ==========================================

# Optional. Configure when PostgreSQL integration is implemented.
# DATABASE_URL=postgresql://username:password@localhost:5432/agent_db

# ==========================================
# Workspace Configuration
# ==========================================

WORKSPACE_ROOT=.agent-workspaces
MAX_FILES_TO_INSPECT=1000
MAX_FILE_SIZE_BYTES=1000000

# ==========================================
# Agent Execution
# ==========================================

MAX_RETRIES=3
EXECUTION_TIMEOUT_SECONDS=120
MAX_OUTPUT_BYTES=1000000

# ==========================================
# Docker Sandbox Configuration
# ==========================================

DOCKER_IMAGE=python:3.12-slim
DOCKER_MEMORY_LIMIT_MB=512
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=128
DOCKER_NETWORK_DISABLED=true
